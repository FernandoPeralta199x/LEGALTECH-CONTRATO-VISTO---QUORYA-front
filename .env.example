# Variaveis publicas do frontend. Nunca coloque secrets em NEXT_PUBLIC_*.
# Atenção: variáveis NEXT_PUBLIC_* são expostas no navegador. Nunca coloque secrets, tokens, senhas ou dados sensíveis nelas.

NEXT_PUBLIC_APP_NAME=Contrato Visto
NEXT_PUBLIC_APP_ENV=local
# Backend serverless local (dev-server) ou, em deploy, o endpoint do API Gateway
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Fallback de mock: só em DEV e só quando o backend está INALCANÇÁVEL (ApiNetworkError),
# nunca em 4xx/5xx nem em produção. Template fail-safe = desligado (fe-config-04);
# ligue no seu .env.local se quiser trabalhar sem o backend de pé.
NEXT_PUBLIC_ENABLE_API_MOCK_FALLBACK=false
