# Variáveis públicas. Tudo em NEXT_PUBLIC_* é exposto no navegador.

NEXT_PUBLIC_APP_NAME=Contrato Visto
NEXT_PUBLIC_APP_ENV=local
# Fallback de mock: só em DEV e só quando o backend está INALCANÇÁVEL (ApiNetworkError),
# nunca em 4xx/5xx nem em produção. Template fail-safe = desligado (fe-config-04);
# ligue no seu .env.local se quiser trabalhar sem o backend de pé.
NEXT_PUBLIC_ENABLE_API_MOCK_FALLBACK=false

# Variáveis exclusivas do servidor Next.js/BFF. Nunca use o prefixo NEXT_PUBLIC_.
# Origem EXATA do frontend, sem barra final (ex.: https://app.exemplo.com).
APP_ORIGIN=http://localhost:3000
# Backend serverless local ou endpoint HTTPS do API Gateway.
API_BASE_URL=http://127.0.0.1:8000
# Gere um segredo aleatório com no mínimo 32 caracteres; não reutilize JWT_SECRET.
AUTH_COOKIE_SECRET=
# Limite do corpo encaminhado pelo BFF (padrão 2 MiB; máximo 10 MiB).
BFF_MAX_BODY_BYTES=2097152
